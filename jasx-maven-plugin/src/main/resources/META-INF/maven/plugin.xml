<?xml version="1.0" encoding="UTF-8"?>
<!--
  The descriptor Maven reads to find this plugin's goals (normally generated by maven-plugin-plugin).
  @version@ is filled in by the Gradle build (processResources).

  Goals: compile and test-compile (CompileMojo), source-names and test-source-names (SourceNamesMojo).
  Each pair shares its implementation; the "scope" parameter, which users can't change, tells them apart.
-->
<plugin>
  <name>JASX Maven Plugin</name>
  <description>Compiles .jasx files (Java with JSX-style markup) to Java.</description>
  <groupId>dev.jasx</groupId>
  <artifactId>jasx-maven-plugin</artifactId>
  <version>@version@</version>
  <goalPrefix>jasx</goalPrefix>
  <isolatedRealm>false</isolatedRealm>
  <inheritedByDefault>true</inheritedByDefault>
  <requiredJavaVersion>21</requiredJavaVersion>
  <requiredMavenVersion>3.6.3</requiredMavenVersion>
  <mojos>

    <mojo>
      <goal>compile</goal>
      <description>Compiles the main .jasx files to Java, type-checks them, and adds the result to the sources.</description>
      <requiresDependencyResolution>compile</requiresDependencyResolution>
      <requiresProject>true</requiresProject>
      <phase>generate-sources</phase>
      <implementation>jasx.maven.CompileMojo</implementation>
      <language>java</language>
      <instantiationStrategy>per-lookup</instantiationStrategy>
      <executionStrategy>once-per-session</executionStrategy>
      <threadSafe>true</threadSafe>
      <parameters>
        <parameter><name>project</name><type>org.apache.maven.project.MavenProject</type><required>true</required><editable>false</editable><description>The project.</description></parameter>
        <parameter><name>scope</name><type>java.lang.String</type><required>true</required><editable>false</editable><description>main</description></parameter>
        <parameter><name>target</name><type>java.lang.String</type><required>true</required><editable>true</editable><description>The id of the JASX target.</description></parameter>
        <parameter><name>typeCheck</name><type>boolean</type><required>false</required><editable>true</editable><description>Whether to type-check the generated Java with javac.</description></parameter>
        <parameter><name>release</name><type>java.lang.String</type><required>false</required><editable>true</editable><description>The Java release to type-check for.</description></parameter>
      </parameters>
      <configuration>
        <project implementation="org.apache.maven.project.MavenProject" default-value="${project}"/>
        <scope implementation="java.lang.String" default-value="main"/>
        <target implementation="java.lang.String" default-value="html">${jasx.target}</target>
        <typeCheck implementation="boolean" default-value="true">${jasx.typeCheck}</typeCheck>
        <release implementation="java.lang.String">${maven.compiler.release}</release>
      </configuration>
    </mojo>

    <mojo>
      <goal>test-compile</goal>
      <description>Compiles the test .jasx files to Java, type-checks them, and adds the result to the test sources.</description>
      <requiresDependencyResolution>test</requiresDependencyResolution>
      <requiresProject>true</requiresProject>
      <phase>generate-test-sources</phase>
      <implementation>jasx.maven.CompileMojo</implementation>
      <language>java</language>
      <instantiationStrategy>per-lookup</instantiationStrategy>
      <executionStrategy>once-per-session</executionStrategy>
      <threadSafe>true</threadSafe>
      <parameters>
        <parameter><name>project</name><type>org.apache.maven.project.MavenProject</type><required>true</required><editable>false</editable><description>The project.</description></parameter>
        <parameter><name>scope</name><type>java.lang.String</type><required>true</required><editable>false</editable><description>test</description></parameter>
        <parameter><name>target</name><type>java.lang.String</type><required>true</required><editable>true</editable><description>The id of the JASX target.</description></parameter>
        <parameter><name>typeCheck</name><type>boolean</type><required>false</required><editable>true</editable><description>Whether to type-check the generated Java with javac.</description></parameter>
        <parameter><name>release</name><type>java.lang.String</type><required>false</required><editable>true</editable><description>The Java release to type-check for.</description></parameter>
      </parameters>
      <configuration>
        <project implementation="org.apache.maven.project.MavenProject" default-value="${project}"/>
        <scope implementation="java.lang.String" default-value="test"/>
        <target implementation="java.lang.String" default-value="html">${jasx.target}</target>
        <typeCheck implementation="boolean" default-value="true">${jasx.typeCheck}</typeCheck>
        <release implementation="java.lang.String">${maven.compiler.release}</release>
      </configuration>
    </mojo>

    <mojo>
      <goal>source-names</goal>
      <description>Makes the classes compiled from .jasx files name their .jasx source, for stack traces.</description>
      <requiresProject>true</requiresProject>
      <!-- compile, not process-classes: Maven runs it right after its own compiler, and "mvn compile" includes it. -->
      <phase>compile</phase>
      <implementation>jasx.maven.SourceNamesMojo</implementation>
      <language>java</language>
      <instantiationStrategy>per-lookup</instantiationStrategy>
      <executionStrategy>once-per-session</executionStrategy>
      <threadSafe>true</threadSafe>
      <parameters>
        <parameter><name>project</name><type>org.apache.maven.project.MavenProject</type><required>true</required><editable>false</editable><description>The project.</description></parameter>
        <parameter><name>scope</name><type>java.lang.String</type><required>true</required><editable>false</editable><description>main</description></parameter>
      </parameters>
      <configuration>
        <project implementation="org.apache.maven.project.MavenProject" default-value="${project}"/>
        <scope implementation="java.lang.String" default-value="main"/>
      </configuration>
    </mojo>

    <mojo>
      <goal>test-source-names</goal>
      <description>Makes the test classes compiled from .jasx files name their .jasx source, for stack traces.</description>
      <requiresProject>true</requiresProject>
      <phase>test-compile</phase>
      <implementation>jasx.maven.SourceNamesMojo</implementation>
      <language>java</language>
      <instantiationStrategy>per-lookup</instantiationStrategy>
      <executionStrategy>once-per-session</executionStrategy>
      <threadSafe>true</threadSafe>
      <parameters>
        <parameter><name>project</name><type>org.apache.maven.project.MavenProject</type><required>true</required><editable>false</editable><description>The project.</description></parameter>
        <parameter><name>scope</name><type>java.lang.String</type><required>true</required><editable>false</editable><description>test</description></parameter>
      </parameters>
      <configuration>
        <project implementation="org.apache.maven.project.MavenProject" default-value="${project}"/>
        <scope implementation="java.lang.String" default-value="test"/>
      </configuration>
    </mojo>

  </mojos>
</plugin>
