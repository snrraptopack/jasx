import jasx.runtime.Element;
import jasx.html.Html;
import java.util.List;

class T {
  static Element Card(String title, List<Element> children) {
    return (
      <section class="card">
        <style>
          .card { padding: 1rem; }
          h2 { margin: 0; }
        </style>
        <h2>{title}</h2>
        {children}
      </section>
    );
  }

  static Element Test() {
    return (
      <>
        {Html.styles()}
        <Card title="A">
          <style>p { color: gray; }</style>
          <p>body</p>
        </Card>
      </>
    );
  }
}
