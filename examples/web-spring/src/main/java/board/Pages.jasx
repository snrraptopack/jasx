package board;

import jasx.runtime.Element;
import org.springframework.http.HttpStatus;
import org.springframework.stereotype.Controller;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.server.ResponseStatusException;

import static board.BoardView.*;
import static board.TaskView.*;

/**
 * The pages: ordinary Spring MVC controller methods. Spring routes the request, binds its parameters and injects
 * the services; the method returns the page's markup. A method that returns an {@code Element} runs inside a new
 * page, so the state its components create belongs to that page.
 */
@Controller
public class Pages {
    private final TaskService tasks;

    public Pages(TaskService tasks) {
        this.tasks = tasks;
    }

    /** The board. {@code /?show=open} starts with a filter. */
    @GetMapping("/")
    public Element board(@RequestParam(defaultValue = "all") String show) {
        return <Board tasks={tasks} show={show} />;
    }

    /** One task. An unknown id is a 404, as anywhere in Spring. */
    @GetMapping("/tasks/{id}")
    public Element task(@PathVariable long id) {
        if (tasks.find(id).isEmpty()) {
            throw new ResponseStatusException(HttpStatus.NOT_FOUND, "no task " + id);
        }
        return <TaskPage tasks={tasks} id={id} />;
    }
}
