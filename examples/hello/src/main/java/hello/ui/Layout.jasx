package hello.ui;

import jasx.html.Html;
import jasx.runtime.Element;
import java.util.List;

// Shared page layout. There is no class here: the top-level declarations become static members of the
// file class `hello.ui.Layout`, so other files use them with `import static hello.ui.Layout.*`.

// The style block's CSS only applies to the elements written in this file. Html.styles() below puts the
// CSS of every style block used on the page into <head>.
<style>
    body { margin: 0; font-family: system-ui, sans-serif; background: #f6f7f9; }
    .page { max-width: 32rem; margin: 3rem auto; background: white; padding: 2rem; border-radius: 12px; }
    h1 { margin-top: 0; }
    .badge { font-size: .8rem; padding: .1rem .5rem; border-radius: 999px; background: #e5e7eb; }
    .badge.good { background: #d1fae5; }
</style>

/** A full HTML page. `children` receives whatever is written between <Page> and </Page>. */
public Element Page(String title, List<Element> children) {
    return (
        <html lang="en">
            <head>
                <meta charset="utf-8" />
                <title>{title}</title>
                {Html.styles()}
            </head>
            <body>
                <main class="page">
                    <h1>{title}</h1>
                    {children}
                </main>
            </body>
        </html>
    );
}

/** A small badge. `@jasx.Default` gives the prop a value when the attribute is left out. */
public Element Badge(String text, @jasx.Default("\"neutral\"") String tone) {
    return <span class={"badge " + tone}>{text}</span>;
}
