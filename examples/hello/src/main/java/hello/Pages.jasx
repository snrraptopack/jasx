package hello;

import jasx.runtime.Element;
import java.util.List;

import static hello.ui.Layout.*;

/** The pages of the example. A .jasx file is Java plus markup expressions. */
public class Pages {

    /** One to-do item. Components are static methods; their parameters are the props. */
    static Element TodoItem(Todo todo) {
        return (
            <li class={todo.done() ? "todo done" : "todo"}>
                <input type="checkbox" checked={todo.done()} disabled />
                <span>{todo.title()}</span>
            </li>
        );
    }

    /** The home page: a list built with a stream, a computed summary, and a conditional message. */
    public static Element Home(List<Todo> todos) {
        long done = todos.stream().filter(Todo::done).count();

        return (
            <Page title="JASX to-do list">
                <p>
                    <Badge text={done + " of " + todos.size() + " done"} tone={done == todos.size() ? "good" : "neutral"} />
                    {" "}
                    <Badge text="server-rendered" />
                </p>

                {todos.isEmpty()
                    ? <p>Nothing to do &mdash; enjoy your day.</p>
                    : <ul>{todos.stream().map(t -> <TodoItem key={t.id()} todo={t} />).toList()}</ul>}

                <footer>
                    <small>Rendered by the <code>html</code> target &amp; plain Java.</small>
                </footer>
            </Page>
        );
    }
}
