package hello;

import jasx.runtime.Element;
import java.util.List;

import static hello.ui.Layout.*;

// The pages of the example. A .jasx file is Java plus markup expressions; these components are declared at
// the top level, so they are static methods of the file class `hello.Pages`.

// Styles for the elements of this file only: `.badge` from Layout.jasx doesn't leak in here, and the
// `span` rule below doesn't affect the spans of Layout's badges. A style block can be written at the top,
// like this one, in a component before its return, like the one in TodoItem, or inside markup. They all
// go into the same style sheet, which is sent once per page however many items are rendered.
<style>
    footer { margin-top: 1.5rem; color: #6b7280; }
</style>

/** One to-do item. Components are static methods; their parameters are the props. */
Element TodoItem(Todo todo) {
    <style>
        .todo { display: flex; gap: .5rem; align-items: center; padding: .25rem 0; }
        .todo.done span { text-decoration: line-through; opacity: .6; }
    </style>

    return (
        <li class={todo.done() ? "todo done" : "todo"}>
            <input type="checkbox" checked={todo.done()} disabled />
            <span>{todo.title()}</span>
        </li>
    );
}

/** The home page: a list built with a stream, a computed summary, and a conditional message. */
public Element Home(List<Todo> todos) {
    long done = todos.stream().filter(Todo::done).count();

    return (
        <Page title="JASX to-do list">
            <p>
                <Badge text={done + " of " + todos.size() + " done"} tone={done == todos.size() ? "good" : "neutral"} />
                {" "}
                <Badge text="server-rendered" />
            </p>

            {todos.isEmpty()
                ? <p>Nothing to do &mdash; enjoy your day.</p>
                : <ul>{todos.stream().map(t -> <TodoItem key={t.id()} todo={t} />).toList()}</ul>}

            <footer>
                <small>Rendered by the <code>html</code> target &amp; plain Java.</small>
            </footer>
        </Page>
    );
}
